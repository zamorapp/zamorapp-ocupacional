{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zamorApp Escritorio",
  "version": "0.1.0",
  "identifier": "com.tipuroservimedic.zamorapp",
  "build": {
    "frontendDist": "../ventana"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "principal",
        "title": "zamorApp Escritorio",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TIPURO SERVI MEDIC, C.A.",
    "shortDescription": "Salud ocupacional con datos en la PC y en la nube",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../recursos/": "recursos/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/gestionesaguamiel-web/zamorapp-descargas/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
