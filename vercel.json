{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "pdx1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)escritorio' ':(exclude)supabase' ':(exclude)scripts' ':(exclude)docs' ':(exclude).github' ':(exclude)*.md' ':(exclude)auditoria'"
}
